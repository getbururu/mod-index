og":[],"steam":[892970],"ubisoft":[],"xbox":[]}}},"index":1,"min_client":"","mods":{"arcraiders":{"authors":["Bururu"],"for":[],"games":["arc-raiders"],"icon":{"builtin":"target","png":null},"kind":"game","license":"MIT","name":"ARC Raiders","note":"","official":true,"owner_id":339342163,"owner_login":"getbururu","provides":[],"readme":{"sha256":"dd565b54b834e1a2d1704211a944c633a416529d22a63a6eed302c03b4defc39","size":5120},"repo":"getbururu/mod-arcraiders","repo_id":1412083627,"status":"listed","summary":"Adaptive triggers and a lightbar colour for ARC Raiders, next to the game's own haptics.","versions":{"0.1.0":{"api":"0.11","changelog":{"sha256":"8e6f4b8ca54e9c9a4f5cfb20b02168605c937ba9f2a056bea0a3b854b77f81ab","size":590},"dependencies":{},"notes":"The first release.\n\n- R2 clicks like a gun trigger and L2 has a light wall while ARC Raiders is in front; both are free while it is in the background.\n- A calm lightbar colour while the game runs, or off.\n- The haptics stay the game's own.\n- Works on the USB cable only for now. On Bluetooth Bururu leaves the controller to the game.\n- Reads only the controller: no game files, no screen, no keys.\n- A page in Bururu: Effects (Triggers, Lightbar).\n- Needs Bururu with mod API 0.11.","os":["windows","linux"],"permissions":{"files":{},"keyboard":false,"paths":[],"screen":false,"udp":[],"udp_forward":[]},"prerelease":false,"published":"2026-10-09T15:41:56Z","sha256":"98dbac179b2d592f88fc3b9c7d2dbecfce8f922f168f6f338463b7771ecbcc2e","size":8030,"url":"https://github.com/getbururu/mod-arcraiders/releases/download/v0.1.0/arcraiders-0.1.0.brr"}}},"elite":{"authors":["Bururu"],"for":[],"games":["elite-dangerous"],"icon":{"builtin":"ship","png":null},"kind":"game","license":"MIT","name":"Elite Dangerous","note":"","official":true,"owner_id":339342163,"owner_login":"getbururu","provides":[],"readme":{"sha256":"17ae37365e2e7767108f8d21829fe9b458efc9e8c1fc100d0c682d03ed012d71","size":8749},"repo":"getbururu/mod-elite","repo_id":1409419241,"status":"listed","summary":"Haptics, adaptive triggers and lights for Elite Dangerous.","versions":{"0.1.0":{"api":"0.10","changelog":{"sha256":"0554f06947722719a5286f519736775b8f990ec8970c184edad78f6d3ac18428","size":926},"dependencies":{},"notes":"The first release.\n\n- Haptics for weapons, flight, heat, jumps, docking, landings, shields and hits: 97 feels, each with its own level.\n- R2 and L2 follow the situation: hardpoints out, reloading, an empty weapons capacitor, overheating, analysis mode, an interdiction, a hit, the SRV turret, on foot.\n- The lightbar shows your hull and the ship's state; the player LEDs show the fire group and the jump countdown; the mic LED shows low fuel and silent running.\n- Gyro aim pauses in the main menu and in the panels and maps you pick.\n- Reads shields, heat and weapon lists from the HUD.\n- Pages in Bururu: Effects (Haptics, Triggers, Lights) and Settings (HUD reader, In menus, Elite's files).\n- Hook points for add-ons: `weapon_layer@1`, `turn@1`, `heat@1`, `boost@1` and `state@1`.\n- Needs Bururu with mod API 0.10.","os":["windows","linux"],"permissions":{"files":{"bindings":{"label":"Bindings","path":"{LocalAppData}/Frontier Developments/Elite Dangerous/Options/Bindings","setting":"bindings_dir"},"journal":{"label":"Journal","path":"{SavedGames}/Frontier Developments/Elite Dangerous","proton":359320,"setting":"journal_dir"},"options":{"label":"Options","path":"{LocalAppData}/Frontier Developments/Elite Dangerous/Options","proton":359320}},"keyboard":true,"paths":[],"screen":true,"udp":[],"udp_forward":[]},"prerelease":false,"published":"2026-10-09T01:21:05Z","sha256":"bc133375cbede4602b3a3d3a9e9505abd1dbb53fd6c5662382ba3e471a54f218","size":159002,"url":"https://github.com/getbururu/mod-elite/releases/download/v0.1.0/elite-0.1.0.brr"}}},"starcitizen":{"authors":["Bururu"],"for":[],"games":["star-citizen"],"icon":{"builtin":"ship","png":null},"kind":"game","license":"MIT","name":"Star Citizen","note":"","official":true,"owner_id":339342163,"owner_login":"getbururu","provides":[],"readme":{"sha256":"46970e944ec633fea023af2980ebe7516a7db81ee32b19cbc9f5aa72be897296","size":8767},"repo":"getbururu/mod-starcitizen","repo_id":1412091277,"status":"listed","summary":"Haptics, adaptive triggers and lights for Star Citizen, from its Game.log.","versions":{"0.1.0":{"api":"0.11","changelog":{"sha256":"0376516bfe3d8fe1a22b31c7e4e16e7e080543a99baaacafb558ac4cfb64dc46","size":1065},"dependencies":{},"notes":"The first release.\n\n- Reads Star Citizen's `Game.log`: the pilot seat, quantum travel, jumps, hangars, injuries, deaths, the law, contracts, blueprints and shops. Lines about other players and other ships play nothing.\n- 31 feels, each with its own level, and choices for the turn, quantum, jump, downed and fire feels.\n- R2 and L2 resist in the pilot seat and on foot with something in your hand, and are free in armistice zones, while downed and in the main menu.\n- The lightbar shows your health or the star system; the player LEDs count the jump drive's steps or your place in a hangar queue; the mic LED lights outside monitored space and pulses on low fuel.\n- Gyro aim pauses in the main menu, and in the pilot seat if you turn it off there.\n- The Home card shows your ship, the star system and your injury.\n- Hook points for add-ons: `turn@1` and `state@1`. A language pack add-on patches `data/notifications.json`.\n- Needs Bururu with mod API 0.11.","os":["windows"],"permissions":{"files":{"log":{"label":"Star Citizen folder","path":"{GameDir}","setting":"game_dir"}},"keyboard":false,"paths":[],"screen":false,"udp":[],"udp_forward":[]},"prerelease":false,"published":"2026-10-09T15:47:14Z","sha256":"05f66c71257068e3174a300dc5ff8cc259f2ea410984ba1837da1eb27258e460","size":107962,"url":"https://github.com/getbururu/mod-starcitizen/releases/download/v0.1.0/starcitizen-0.1.0.brr"}}},"valheim":{"authors":["Bururu"],"for":[],"games":["valheim"],"icon":{"builtin":"target","png":null},"kind":"game","license":"MIT","name":"Valheim","note":"","official":true,"owner_id":339342163,"owner_login":"getbururu","provides":[],"readme":{"sha256":"0fb1f58383c78455342672720b9564c8ae451e0fe2a54f56b1a0c573098a1375","size":6461},"repo":"getbururu/mod-valheim","repo_id":1412083901,"status":"listed","summary":"Haptics, adaptive triggers and lights for Valheim.","versions":{"0.1.0":{"api":"0.11","changelog":{"sha256":"5ecbacdbb14c52ba66342ace61c2bd2e9fbc45db1605f649b35168e7c647efe1","size":860},"dependencies":{},"notes":"The first release.\n\n- Attack feels from the controller: Swing (a soft swell on each attack) or Bow (a click as the draw starts, a tick at full draw, the string's snap on release), and a light thud when you block.\n- R2 follows the attack feel: a light click, or a pull that gets heavier for the bow. L2 resists a little, for the block.\n- From Valheim's log: drums when a raid starts, and a slow swell when the night passes in bed (the swell only when you play alone or host).\n- The lightbar glows a dim fire colour in a world and blinks red as a raid starts.\n- Pages in Bururu: Effects (Haptics, Triggers, Lights) and Settings (Valheim's controls, Valheim's files).\n- Hook points for add-ons: `attack@1` and `state@1`.\n- Needs Bururu with mod API 0.11.","os":["windows","linux"],"permissions":{"files":{"logs":{"label":"Valheim's log","linux":"{RoamingAppData}/unity3d/IronGate/Valheim","path":"{Home}/AppData/LocalLow/IronGate/Valheim","setting":"log_dir"}},"keyboard":false,"paths":[],"screen":false,"udp":[],"udp_forward":[]},"prerelease":false,"published":"2026-10-09T15:42:06Z","sha256":"db3cd3238422b04f97d43630e33134e5aa924e4fc646017fe50fb8454c29542f","size":21156,"url":"https://github.com/getbururu/mod-valheim/releases/download/v0.1.0/valheim-0.1.0.brr"}}}},"revoked":[],"serial":6}
